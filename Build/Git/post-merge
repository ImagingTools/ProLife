#!/bin/sh

echo "Running post-merge hook..."

REPO_ROOT="$(pwd)"

# Execute UpdateVersion script based on OS
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*|Windows_NT)
        SCRIPT_FILE="$REPO_ROOT/Build/Git/UpdateVersion.bat"
        if [ -f "$SCRIPT_FILE" ]; then
            echo "Executing UpdateVersion..."
            cd "$REPO_ROOT"
            cmd //c "$SCRIPT_FILE"
        else
            echo "Script not found: $SCRIPT_FILE"
        fi
        ;;
    *)
        SCRIPT_FILE="$REPO_ROOT/Build/Git/UpdateVersion.sh"
        if [ -f "$SCRIPT_FILE" ]; then
            echo "Executing UpdateVersion..."
            cd "$REPO_ROOT"
            bash "$SCRIPT_FILE"
        else
            echo "Script not found: $SCRIPT_FILE"
        fi
        ;;
esac

echo "Post-merge hook completed"