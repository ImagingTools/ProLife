<RCC>
    <qresource prefix="/Images">
        <file alias="ProLifeSplashScreen">Resources/Images/ProLifeSplashScreen.svg</file>
    </qresource>
    <qresource prefix="/Icons">
        <file alias="ProLifeIcon">Resources/Icons/ProLifeIcon.svg</file>
    </qresource>
    <qresource prefix="/Palette"/>
    <qresource prefix="/"/>
    <qresource prefix="/qml">
        <file alias="Acf/Style.qml">Qml/Acf/Style.qml</file>
        <file alias="prolife.qml">Resources/qml/prolife.qml</file>
        <file alias="ProLife/ProLifeMain.qml">Qml/ProLifeMain.qml</file>
        <file alias="ProLife/OrderCollectionView.qml">Qml/OrderCollectionView.qml</file>
        <file alias="ProLife/OrderEditor.qml">Qml/OrderEditor.qml</file>
        <file alias="ProLife/DeviceEditor.qml">Qml/DeviceEditor.qml</file>
	<file alias="ProLife/InstallationEditor.qml">Qml/InstallationEditor.qml</file>
        <file alias="ProLife/LicenseFileController.qml">Qml/LicenseFileController.qml</file>
        <file alias="ProLife/ProductEditorDialog.qml">Qml/ProductEditorDialog.qml</file>
	<file alias="ProLife/DeviceEditorDialog.qml">Qml/DeviceEditorDialog.qml</file>
        <file alias="ProLife/OrderEditorCommandsDelegate.qml">Qml/OrderEditorCommandsDelegate.qml</file>
        <file alias="ProLife/OrderProductView.qml">Qml/OrderProductView.qml</file>
        <file alias="ProLife/OrderCommandsModelObserver.qml">Qml/OrderCommandsModelObserver.qml</file>
        <file alias="ProLife/DeviceCollectionView.qml">Qml/DeviceCollectionView.qml</file>
	<file alias="ProLife/DeviceCollectionViewCommandsDelegate.qml">Qml/DeviceCollectionViewCommandsDelegate.qml</file>
	<file alias="ProLife/DeviceProductionStatus.qml">Qml/DeviceProductionStatus.qml</file>
	<file alias="ProLife/OrderStatus.qml">Qml/OrderStatus.qml</file>
	<file alias="ProLife/InstanceMaskProvider.qml">Qml/InstanceMaskProvider.qml</file>
	<file alias="ProLife/ProductPairCard.qml">Qml/ProductPairCard.qml</file>
	<file alias="ProLife/SoftwareProductCard.qml">Qml/SoftwareProductCard.qml</file>
	<file alias="ProLife/HardwareProductCard.qml">Qml/HardwareProductCard.qml</file>
	<file alias="ProLife/OrderProductCard.qml">Qml/OrderProductCard.qml</file>
    </qresource>
    <qresource prefix="/Style">
        <file alias="prolife_dark.theme">prolife_dark.theme</file>
        <file alias="prolife_light.theme">prolife_light.theme</file>
    </qresource>
    <qresource prefix="/Decorators">
        <file alias="prolife_decorators.theme">prolife_decorators.theme</file>
    </qresource>
    <qresource prefix="/Features">
        <file alias="ProLifeFeatures">Resources/Features/ProLifeFeatures.xml</file>
    </qresource>
    <qresource prefix="/ProLife">
        <file alias="ProductEditor.qml">Qml/ProductEditor.qml</file>
        <file alias="ProductEditorCommandsDelegate.qml">Qml/ProductEditorCommandsDelegate.qml</file>
        <file alias="ProductCollectionView.qml">Qml/ProductCollectionView.qml</file>
    </qresource>
</RCC>
