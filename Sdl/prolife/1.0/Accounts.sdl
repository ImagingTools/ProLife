schema {
	query: Query
	mutation: Mutation
	subscription: Subscription
	namespace: prolife
	version: 1.0
}

import {
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtCollection.sdl"
}

input AccountsListInput {
	viewParams: CollectionViewParams
}

type AccountItem {
	typeId: ID!
	id: ID!
	customerId: ID
	name: String!
	description: String
	email: String
	country: String
	website: String
	isCustomer: Bool
	isManufacturer: Bool
	isSupplier: Bool
	## The roles as text for the list, e.g. "Customer, Supplier".
	roles: String
	added: String
	timeStamp: String
}

type AccountsListPayload {
	items: [AccountItem]
	notification: NotificationItem
}

type AccountData {
	id: ID
	## Name of the account. Required, unique.
	name: String
	## Customer number ("Customer-ID"), unique if given.
	customerId: ID
	description: String
	email: String
	companyName: String
	country: String
	city: String
	postalCode: String
	street: String
	## User groups that see the account and its orders, devices and licenses without the ViewAll permission.
	groups: String
	website: String
	isCustomer: Bool
	isManufacturer: Bool
	isSupplier: Bool
}

input AccountDataInput {
	id: ID!
	item: AccountData!
}

type Query {
	AccountsList (input:AccountsListInput): AccountsListPayload!
	AccountItem (input: InputId): AccountData!
}

type Mutation {
	AccountUpdate (input: AccountDataInput): UpdatedNotificationPayload!
	AccountAdd (input: AccountDataInput): AddedNotificationPayload!
}

collectionSchema {
	type Account {
		ref: AccountItem
		operations {
			list: AccountsList
		}
		subtype Account {
			ref: AccountData
			operations {
				get: AccountItem
				update: AccountUpdate
				insert: AccountAdd
			}
		}
	}
}


