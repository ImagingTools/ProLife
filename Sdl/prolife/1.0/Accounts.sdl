schema {
	query: Query
	mutation: Mutation
	subscription: Subscription
	namespace: prolife
	version: 1.0
}

import {
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtCollection.sdl"
}

input AccountsListInput {
	viewParams: CollectionViewParams
}

type AccountItem {
	typeId: ID!
	id: ID!
	customerId: ID
	name: String!
	description: String
	email: String
	added: String
	timeStamp: String
}

type AccountsListPayload {
	items: [AccountItem]
	notification: NotificationItem
}

type AccountData {
	id: ID
	name: String
	customerId: ID
	description: String
	email: String
	companyName: String
	country: String
	city: String
	postalCode: String
	street: String
	groups: String
}

input AccountDataInput {
	id: ID!
	item: AccountData!
}

type Query {
	AccountsList (input:AccountsListInput): AccountsListPayload!
	AccountItem (input: InputId): AccountData!
}

type Mutation {
	AccountUpdate (input: AccountDataInput): UpdatedNotificationPayload!
	AccountAdd (input: AccountDataInput): AddedNotificationPayload!
}

collectionSchema {
	type Account {
		ref: AccountItem
		operations {
			list: AccountsList
		}
		subtype Account {
			ref: AccountData
			operations {
				get: AccountItem
				update: AccountUpdate
				insert: AccountAdd
			}
		}
	}
}


