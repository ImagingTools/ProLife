schema {
	namespace: prolife
	version: 1.0
	query: Query
	mutation: Mutation
}

import {
	"Sensors.sdl"
	"../../../../ImtCore/Sdl/imtbase/1.0/CollectionDocumentManager.sdl"
	"../../../../ImtCore/Sdl/imtbase/1.0/UndoManager.sdl"
}

type UpdateDeviceInput {
	documentId: ID!
	deviceData: DeviceData!
}

type UpdateIotDeviceInput {
	documentId: ID!
	iotDeviceData: IotDeviceData!
}

type Query {
	GetDeviceRepresentation(input: DocumentId): DeviceData!
	GetIotDeviceRepresentation(input: DocumentId): IotDeviceData!
}

type Mutation {
	UpdateDeviceFromRepresentation(input: UpdateDeviceInput): DocumentOperationStatus!
	UpdateIotDeviceFromRepresentation(input: UpdateIotDeviceInput): DocumentOperationStatus!
}
