schema {
	namespace: prolife
	version: 1.0
	query: Query
	mutation: Mutation
}

import {
	"HardwareConfigurations.sdl"
	"../../../../ImtCore/Sdl/imtbase/1.0/CollectionDocumentService.sdl"
	"../../../../ImtCore/Sdl/imtbase/1.0/UndoManager.sdl"
}

type UpdateHardwareConfigurationInput {
	documentId: ID!
	configurationData: HardwareConfigurationData!
}

type Query {
	GetHardwareConfigurationRepresentation(input: DocumentId): HardwareConfigurationData!
}

type Mutation {
	UpdateHardwareConfigurationFromRepresentation(input: UpdateHardwareConfigurationInput): DocumentOperationStatus!
}
