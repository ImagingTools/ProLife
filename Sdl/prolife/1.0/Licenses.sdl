
schema {
	query: Query
	mutation: Mutation
	subscription: Subscription
	name: Licenses
	namespace: prolife
	version: 1.0
}

import {
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtCollection.sdl"
}

input SoftwareProductsListInput {
	viewParams: CollectionViewParams
}

type SoftwareProductItem {
	TypeId: ID!
	Id: ID!
	Name: String!
	Description: String
	DeliveryId: String
	PurchaseId: String
	CustomerId: String
	CustomerName: String
	OrderUuid: String
	MacAddress: String
	ProductId: String
	ProductName: String
	ProductUuid: String
	SerialNumber: String
	Expiration: String
	IsPaired: Bool
	InUse: Bool
	HardwareId: String
	LicenseName: String
	LicenseId: String
	LicenseUuid: String
	Project: String
	Status: String
	Added: String
	TimeStamp: String
}

type SoftwareProductsListPayload {
	items: [SoftwareProductItem]
	notification: NotificationItem
}

type SoftwareProductData {
	Id: ID
	ProductId: ID
	CategoryId: ID
	SerialNumber: ID
	Project: String
	InUse: Bool
	OrderUuid: ID
	LicenseUuid: ID
	Expiration: String
}

input SoftwareProductDataInput {
	Id: ID!
	Item: SoftwareProductData!
}

type Query {
	SoftwareProductsList (input:SoftwareProductsListInput): SoftwareProductsListPayload!
	SoftwareProductItem (input: InputId): SoftwareProductData!
}

type Mutation {
	SoftwareProductUpdate (input: SoftwareProductDataInput): UpdatedNotificationPayload!
	SoftwareProductAdd (input: SoftwareProductDataInput): AddedNotificationPayload!
}

collectionSchema {
	type SoftwareProduct {
		ref: SoftwareProductItem
		operations {
			list: SoftwareProductsList
		}
		subtype SoftwareProduct {
			ref: SoftwareProductData
			operations {
				get: SoftwareProductItem
				update: SoftwareProductUpdate
				insert: SoftwareProductAdd
			}
		}
	}
}


