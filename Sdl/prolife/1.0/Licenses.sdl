schema {
	query: Query
	mutation: Mutation
	subscription: Subscription
	namespace: prolife
	version: 1.0
}

import {
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtCollection.sdl"
}

input SoftwareProductsListInput {
	viewParams: CollectionViewParams
}

type SoftwareProductItem {
	id: ID!
	typeId: ID!
	name: String!
	description: String
	deliveryIdLink: ObjectLink
	purchaseIdLink: ObjectLink
	customerLink: ObjectLink
	hardwareLink: ObjectLink
	productId: String
	productName: String
	productUuid: String
	serialNumber: String
	expiration: String
	isPaired: Bool
	inUse: Bool
	licenseName: String
	licenseId: String
	licenseUuid: String
	project: String
	status: String
	added: String
	timeStamp: String
	isMultiple: Bool
	productCount: Integer
}

type SoftwareProductsListPayload {
	items: [SoftwareProductItem]
	notification: NotificationItem
}

type SoftwareProductData {
	id: ID
	productId: ID
	categoryId: ID
	serialNumber: ID
	project: String
	inUse: Bool
	orderUuid: ID
	licenseUuid: ID
	expiration: String
	internalUse: Bool
	isMultiple: Bool
	productCount: Integer
	parentInstanceId: ID
}

input SoftwareProductDataInput {
	id: ID!
	item: SoftwareProductData!
}

input SplitLicenseInput {
	licenseId: ID!
	licenseCount: Integer!
	accountId: ID!
}

type SplitLicensePayload {
	ok: Boolean
	message: String
}

input ChildLicensesListInput {
	parentLicenseId: ID!
}

type ChildLicenseItem {
	id: ID!
	accountId: ID
	accountName: String
	productCount: Integer
	softwareId: String
	availableCount: Integer
	boundCount: Integer
}

type ChildLicensesListPayload {
	items: [ChildLicenseItem]
	ok: Boolean
	message: String
}

input RevokeLicenseInput {
	childLicenseId: ID!
	revokeCount: Integer!
}

type RevokeLicensePayload {
	ok: Boolean
	message: String
}

type Query {
	SoftwareProductsList (input:SoftwareProductsListInput): SoftwareProductsListPayload!
	SoftwareProductItem (input: InputId): SoftwareProductData!
	ChildLicensesList (input: ChildLicensesListInput): ChildLicensesListPayload!
}

type Mutation {
	SoftwareProductUpdate (input: SoftwareProductDataInput): UpdatedNotificationPayload!
	SoftwareProductAdd (input: SoftwareProductDataInput): AddedNotificationPayload!
	SplitLicense (input: SplitLicenseInput): SplitLicensePayload!
	RevokeLicense (input: RevokeLicenseInput): RevokeLicensePayload!
}

collectionSchema {
	type SoftwareProduct {
		ref: SoftwareProductItem
		operations {
			list: SoftwareProductsList
		}
		subtype SoftwareProduct {
			ref: SoftwareProductData
			operations {
				get: SoftwareProductItem
				update: SoftwareProductUpdate
				insert: SoftwareProductAdd
			}
		}
	}
}


