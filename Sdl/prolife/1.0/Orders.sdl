schema {
	query: Query
	mutation: Mutation
	subscription: Subscription
	namespace: prolife
	version: 1.0
}

import {
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtCollection.sdl"
}

input OrdersListInput {
	viewParams: CollectionViewParams
}

enum OrderCustomerRoleType {
	ORDERING_PARTY
	END_CUSTOMER
	INVOICE_RECIPIENT
	DELIVERY_RECIPIENT
	RESELLER
	REFERRER
}

type OrderCustomerRole {
	customerId: ID!
	customerName: String
	roleType: OrderCustomerRoleType!
}

type OrderItem {
	typeId: ID!
	id: ID!
	name: String
	customerName: String
	customerLink: ObjectLink
	status: String
	orderId: ID
	purchaseId: ID
	description: String
	added: String
	timeStamp: String
}

type OrdersListPayload {
	items: [OrderItem]
	notification: NotificationItem
}

type OrderedProduct {
	id: ID!
	productUuid: ID
	licenseUuid: ID
	categoryId: ID
	licenseId: ID
	productName: String
	licenseName: String
	serialNumber: ID
	inUse: Bool
	isNew: Bool
	macAddress: ID

	# Only for software
	expiration: String
	isMultiple: Bool
	productCount: Integer
}

type OrderData {
	id: ID
	name: String
	description: String
	orderId: ID
	purchaseId: ID
	customerId: ID
	orderStatus: ID
	orderProducts: [OrderedProduct]
	customerRoles: [OrderCustomerRole]
}

input OrderDataInput {
	id: ID!
	item: OrderData!
}

type Query {
	OrdersList (input:OrdersListInput): OrdersListPayload!
	OrderItem (input: InputId): OrderData!
}

type Mutation {
	OrderUpdate (input: OrderDataInput): UpdatedNotificationPayload!
	OrderAdd (input: OrderDataInput): AddedNotificationPayload!
}

collectionSchema {
	type Order {
		ref: OrderItem
		operations {
			list: OrdersList
		}
		subtype Order {
			ref: OrderData
			operations {
				get: OrderItem
				update: OrderUpdate
				insert: OrderAdd
			}
		}
	}
}


