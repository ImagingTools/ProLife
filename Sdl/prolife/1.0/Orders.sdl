schema {
	query: Query
	mutation: Mutation
	subscription: Subscription
	name: Orders
	namespace: prolife
	version: 1.0
}

import {
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtCollection.sdl"
}

input OrdersListInput {
	viewParams: CollectionViewParams
}

type OrderItem {
	TypeId: ID!
	Id: ID!
	Name: String
	CustomerId: ID
	Status: String
	OrderId: ID
	PurchaseId: ID
	CustomerName: String
	Description: String
	Added: String
	TimeStamp: String
}

type OrdersListPayload {
	items: [OrderItem]
	notification: NotificationItem
}

type OrderedProduct {
	Id: ID!
	ProductUuid: ID
	LicenseUuid: ID
	CategoryId: ID
	LicenseId: ID
	ProductName: String
	LicenseName: String
	SerialNumber: ID
	InUse: Bool
	IsNew: Bool
	Expiration: String
	MacAddress: ID
}

type OrderData {
	Id: ID
	Name: String
	Description: String
	OrderId: ID
	PurchaseId: ID
	CustomerId: ID
	OrderStatus: ID
	OrderProducts: [OrderedProduct]
}

input OrderDataInput {
	Id: ID!
	Item: OrderData!
}

type OrderDataPayload {
	OrderData: OrderData
}

type Query {
	OrdersList (input:OrdersListInput): OrdersListPayload!
	OrderItem (input: InputId): OrderDataPayload!
}

type Mutation {
	OrderUpdate (input: OrderDataInput): UpdatedNotificationPayload!
	OrderAdd (input: OrderDataInput): AddedNotificationPayload!
}

collectionSchema {
	type Order {
		ref: OrderItem
		operations {
			list: OrdersList
		}
		subtype Order {
			ref: OrderData
			operations {
				get: OrderItem
				update: OrderUpdate
				insert: OrderAdd
			}
		}
	}
}


