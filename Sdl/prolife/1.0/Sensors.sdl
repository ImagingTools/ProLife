
schema {
	query: Query
	mutation: Mutation
	subscription: Subscription
	namespace: prolife
	version: 1.0
}

import {
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtCollection.sdl"
}

input DevicesListInput {
	viewParams: CollectionViewParams
}

input IotDevicesListInput {
	viewParams: CollectionViewParams
}

type ProductionStatus {
	id: ID!
	name: String!
	icon: String
}

type ProductionStatusModel {
	statusModel: [ProductionStatus]
}

type SoftwareBindingInfo {
	id: ID!
	softwareId: ID!
	softwareName: String!
}

type DeviceItem {
	typeId: ID!
	id: ID!
	name: String!
	description: String
	## Read only: the Delivery-ID of the order, resolved at every request.
	deliveryIdLink: ObjectLink
	## Read only: the Purchase Order-ID of the order, resolved at every request.
	purchaseIdLink: ObjectLink
	licenseId: ID
	productUuid: ID
	licenseUuid: ID
	## Read only: the customer of the order, resolved at every request.
	customerLink: ObjectLink
	## Name of the production status, see statusId.
	status: String
	## Production status: None, Accepted, InProgress, Canceled, OnHold, Finished, Defected, InRepair, Decommissioned. The list filter "Status" takes its number 0..8 in this order.
	statusId: String
	deviceType: String
	productName: String
	licenseName: String
	macAddress: String
	serialNumber: String
	project: String
	## Read only: the device has bound licenses.
	inUse: Bool
	added: String
	timeStamp: String
}

type DevicesListPayload {
	items: [DeviceItem]
	notification: NotificationItem
}

type DeviceData {
	id: ID
	name: String
	description: String
	## MAC address aa:bb:cc:dd:ee:ff, unique; needed for the license file.
	macAddress: String
	## Serial number, unique.
	serialNumber: String
	## ID of the hardware model (a catalog product of the category Hardware). Required.
	deviceType: String
	## Read only: name of the hardware model.
	productName: String
	## ID of the order document (not the Delivery-ID); empty without an order.
	orderId: String
	## Read only: Delivery-ID of the order.
	orderName: String
	## ID of the hardware configuration, despite the name. Required; must belong to the hardware model in deviceType.
	licenseName: String
	## Read only: name of the configuration.
	configurationName: String
	## Read only: article number of the configuration.
	configurationArticle: String
	project: String
	## Production status: None, Accepted, InProgress, Canceled, OnHold, Finished, Defected, InRepair, Decommissioned. License files and transfers need Finished.
	productionStatus: String
	## Read only: the bound licenses; change them with UpdateDeviceBinding.
	softwareBindingInfos: [SoftwareBindingInfo]
	## Device of the own company; left out of the statistics.
	internalUse: Bool
}

type DeviceBindingData {
	id: ID!
	productUuid: ID
	productName: String
	project: String
	## IDs of all licenses bound to the device: the whole new list, missing licenses are unbound. All of the same software product.
	softwareIds: [ID]
}

input DeviceDataInput {
	id: ID!
	item: DeviceData!
}

input DeviceBindingInput {
	deviceId: ID!
	item: DeviceBindingData!
	## Project taken over by the newly bound licenses.
	project: String
}

type IotDeviceItem {
	typeId: ID!
	id: ID!
	name: String!
	description: String
	factoryNumber: String
	modemNumber: String
	manufacturer: String
	brandModel: String
	installationLocation: String
	connectionType: String
	resourceType: String
	holeDiameter: String
	deviceCategory: String
	calibrationDate: String
	commissionDate: String
	added: String
	timeStamp: String
}

type IotDevicesListPayload {
	items: [IotDeviceItem]
	notification: NotificationItem
}

type IotDeviceData {
	serialNumber: ID
	manufacturer: ID
	modelId: ID
	modelName: String
}

input IotDeviceDataInput {
	id: ID!
	item: IotDeviceData!
}

input GetDeviceBindingInput {
	id: ID!
}

input TransferLicensesInput {
	## Device whose licenses move; must be Finished and is set to Defected after the transfer.
	fromDeviceId: ID!
	## Device receiving the licenses; must have no licenses.
	toDeviceId: ID!
}

input CreateLicenseFileInput {
	deviceId: ID!
	## Encrypt the license file.
	encrypt: Bool
}

input DecryptLicenseFileInput {
	key: ID!
	fileData: ID!
}

input ResetTransferCounterInput {
	## Device whose licenses get their transfer counters reset.
	hardwareId: ID!
}

type ResetTransferCounterPayload {
	result: Boolean!
	message: String
}

type TransferLicensesPayload {
	ok: Boolean
	## A license reached its transfer limit (3 by default); nothing was transferred.
	limit: Boolean
	## Address of the support for a transfer request beyond the limit.
	supportEmail: String
}

type RequestTransferLicensesPayload {
	result: Boolean!
}

type CreateLicenseFilePayload {
	name: String!
	data: String!
}

type DecryptLicenseFilePayload {
	fileName: String!
	decryptedData: ID!
}

type Query {
	DevicesList (input:DevicesListInput): DevicesListPayload!
	DeviceItem (input: InputId): DeviceData!
	GetDeviceBinding (input: GetDeviceBindingInput): DeviceBindingData!
	IotDevicesList (input: IotDevicesListInput): IotDevicesListPayload!
	IotDeviceItem (input: InputId): IotDeviceData!
}

type Mutation {
	DeviceUpdate (input: DeviceDataInput): UpdatedNotificationPayload!
	DeviceAdd (input: DeviceDataInput): AddedNotificationPayload!
	UpdateDeviceBinding (input: DeviceBindingInput): UpdatedNotificationPayload!
	TransferLicenses (input: TransferLicensesInput): TransferLicensesPayload!
	RequestTransferLicenses (input: TransferLicensesInput): RequestTransferLicensesPayload!
	CreateLicenseFile (input: CreateLicenseFileInput): CreateLicenseFilePayload!
	DecryptLicenseFile (input: DecryptLicenseFileInput): DecryptLicenseFilePayload!
	ResetTransferCounter (input: ResetTransferCounterInput): ResetTransferCounterPayload!
	IotDeviceUpdate (input: IotDeviceDataInput): UpdatedNotificationPayload!
	IotDeviceAdd (input: IotDeviceDataInput): AddedNotificationPayload!
}

collectionSchema {
	type Device {
		ref: DeviceItem
		operations {
			list: DevicesList
		}
		subtype Device {
			ref: DeviceData
			operations {
				get: DeviceItem
				update: DeviceUpdate
				insert: DeviceAdd
			}
		}
	}
	type IotDevice {
		ref: IotDeviceItem
		operations {
			list: IotDevicesList
		}
		subtype IotDevice {
			ref: IotDeviceData
			operations {
				get: IotDeviceItem
				update: IotDeviceUpdate
				insert: IotDeviceAdd
			}
		}
	}
}


