
schema {
	query: Query
	mutation: Mutation
	subscription: Subscription
	namespace: prolife
	version: 1.0
}

import {
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtCollection.sdl"
}

input DevicesListInput {
	viewParams: CollectionViewParams
}

input IotDevicesListInput {
	viewParams: CollectionViewParams
}

type ProductionStatus {
	id: ID!
	name: String!
	icon: String
}

type ProductionStatusModel {
	statusModel: [ProductionStatus]
}

type SoftwareBindingInfo {
	id: ID!
	softwareId: ID!
	softwareName: String!
}

type DeviceItem {
	typeId: ID!
	id: ID!
	name: String!
	description: String
	deliveryIdLink: ObjectLink
	purchaseIdLink: ObjectLink
	licenseId: ID
	productUuid: ID
	licenseUuid: ID
	customerLink: ObjectLink
	status: String
	statusId: String
	deviceType: String
	productName: String
	licenseName: String
	macAddress: String
	serialNumber: String
	project: String
	inUse: Bool
	added: String
	timeStamp: String
}

type DevicesListPayload {
	items: [DeviceItem]
	notification: NotificationItem
}

type DeviceData {
	id: ID
	name: String
	description: String
	macAddress: String
	serialNumber: String
	deviceType: String
	orderId: String
	licenseName: String
	project: String
	endCustomerId: ID
	station: String
	area: String
	productionStatus: String
	softwareBindingInfos: [SoftwareBindingInfo]
	internalUse: Bool
}

type DeviceBindingData {
	id: ID!
	productUuid: ID
	project: String
	softwareIds: [ID]
}

input DeviceDataInput {
	id: ID!
	item: DeviceData!
}

input DeviceBindingInput {
	deviceId: ID!
	item: DeviceBindingData!
	project: String
}

type IotDeviceItem {
	typeId: ID!
	id: ID!
	name: String!
	description: String
	factoryNumber: String
	modemNumber: String
	manufacturer: String
	brandModel: String
	installationLocation: String
	connectionType: String
	resourceType: String
	holeDiameter: String
	deviceCategory: String
	calibrationDate: String
	commissionDate: String
	added: String
	timeStamp: String
}

type IotDevicesListPayload {
	items: [IotDeviceItem]
	notification: NotificationItem
}

type IotDeviceData {
	serialNumber: ID
	manufacturer: ID
	modelId: ID
	modelName: String
}

input IotDeviceDataInput {
	id: ID!
	item: IotDeviceData!
}

input GetDeviceBindingInput {
	id: ID!
}

input TransferLicensesInput {
	fromDeviceId: ID!
	toDeviceId: ID!
}

input CreateLicenseFileInput {
	deviceId: ID!
	encrypt: Bool
}

input DecryptLicenseFileInput {
	key: ID!
	fileData: ID!
}

input ResetTransferCounterInput {
	hardwareId: ID!
}

type ResetTransferCounterPayload {
	result: Boolean!
	message: String
}

type TransferLicensesPayload {
	ok: Boolean
	limit: Boolean
	supportEmail: String
}

type RequestTransferLicensesPayload {
	result: Boolean!
}

type CreateLicenseFilePayload {
	name: String!
	data: String!
}

type DecryptLicenseFilePayload {
	fileName: String!
	decryptedData: ID!
}

type Query {
	DevicesList (input:DevicesListInput): DevicesListPayload!
	DeviceItem (input: InputId): DeviceData!
	GetDeviceBinding (input: GetDeviceBindingInput): DeviceBindingData!
	IotDevicesList (input: IotDevicesListInput): IotDevicesListPayload!
	IotDeviceItem (input: InputId): IotDeviceData!
}

type Mutation {
	DeviceUpdate (input: DeviceDataInput): UpdatedNotificationPayload!
	DeviceAdd (input: DeviceDataInput): AddedNotificationPayload!
	UpdateDeviceBinding (input: DeviceBindingInput): UpdatedNotificationPayload!
	TransferLicenses (input: TransferLicensesInput): TransferLicensesPayload!
	RequestTransferLicenses (input: TransferLicensesInput): RequestTransferLicensesPayload!
	CreateLicenseFile (input: CreateLicenseFileInput): CreateLicenseFilePayload!
	DecryptLicenseFile (input: DecryptLicenseFileInput): DecryptLicenseFilePayload!
	ResetTransferCounter (input: ResetTransferCounterInput): ResetTransferCounterPayload!
	IotDeviceUpdate (input: IotDeviceDataInput): UpdatedNotificationPayload!
	IotDeviceAdd (input: IotDeviceDataInput): AddedNotificationPayload!
}

collectionSchema {
	type Device {
		ref: DeviceItem
		operations {
			list: DevicesList
		}
		subtype Device {
			ref: DeviceData
			operations {
				get: DeviceItem
				update: DeviceUpdate
				insert: DeviceAdd
			}
		}
	}
	type IotDevice {
		ref: IotDeviceItem
		operations {
			list: IotDevicesList
		}
		subtype IotDevice {
			ref: IotDeviceData
			operations {
				get: IotDeviceItem
				update: IotDeviceUpdate
				insert: IotDeviceAdd
			}
		}
	}
}

