schema {
	query: Query
	namespace: prolife
	version: 1.0
}

import {
	"../../../../ImtCore/Sdl/imtbase/1.0/ComplexCollectionFilter.sdl"
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtBaseTypes.sdl"
}

type ChartAxes {
	xLabel: String
	yLabel: String
}

type ChartSegment {
	label: String!
	value: Int!
	color: String
}

type ChartBar {
	label: String!
	total: Int!
	segments: [ChartSegment!]!
}

type ChartSummary {
	total: Int!
	maxItem: ChartSegment
}

type PieChartData {
	axes: ChartAxes
	segments: [ChartSegment!]!
	summary: ChartSummary
}

type BarChartData {
	axes: ChartAxes!
	labels: [String!]!
	bars: [ChartBar!]!
	stacked: Boolean! # true если stacked, false — обычная bar
	summary: ChartSummary
}

type LineChartData {
	axes: ChartAxes!
	labels: [String!]!
	points: [SdlPoint!]!
	summary: ChartSummary
}

enum Product {
	Software
	Hardware
}

type LicenseProductInfo {
	productInfo: Product!
}

type CollectionSummaryInfo {
	total: Integer!
	collectionId: ID!
	title: String!
	icon: String!
	objectTypeId: ID!
}

type TotalSummaryInfo {
	summaryInfos: [CollectionSummaryInfo!]!
}

type Query {
	GetLicenseCreationInfo (input: TimeFilter): LineChartData!
	GetLicenseProductStats (input: LicenseProductInfo): PieChartData!
	GetHardwareStatusInfo: PieChartData!
	GetTotalSummaryInfo: TotalSummaryInfo!
}


