schema {
	query: Query
	namespace: prolife
	version: 1.0
}

import {
	"../../../../ImtCore/Sdl/imtbase/1.0/ComplexCollectionFilter.sdl"
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtBaseTypes.sdl"
}

type ChartAxes {
	xLabel: String
	yLabel: String
}

type ChartSegment {
	id: ID
	label: String!
	value: Int!
	color: String
}

type ChartBar {
	label: String!
	total: Int!
	segments: [ChartSegment]!
}

type ChartSummary {
	total: Int!
	maxItem: ChartSegment
}

type PieChartData {
	axes: ChartAxes
	segments: [ChartSegment]!
	summary: ChartSummary
}

type BarChartData {
	axes: ChartAxes!
	bars: [ChartBar!]!
	summary: ChartSummary
}

type LineChartData {
	axes: ChartAxes!
	labels: [String!]!
	points: [SdlPoint!]!
	summary: ChartSummary
}

type CollectionSummaryInfo {
	total: Integer!
	notInUseCount: Integer
	inUseCount: Integer
	internalUseCount: Integer
	collectionId: ID!
	title: String!
	icon: String!
	objectTypeId: ID!
}

type TotalSummaryInfo {
	summaryInfos: [CollectionSummaryInfo!]!
}

input ChartInput {
	timeFilter: TimeFilter
	customerId: ID
}

type Query {
	GetLicenseCreationInfo (input: ChartInput): LineChartData!
	GetSoftwareUsedBarChart (input: ChartInput): BarChartData!
	GetSoftwareUsedPieChart (input: ChartInput): PieChartData!
	GetHardwareUsedBarChart (input: ChartInput): BarChartData!
	GetHardwareUsedPieChart (input: ChartInput): PieChartData!
	GetHardwareStatusInfo (input: ChartInput): PieChartData!
	GetTotalSummaryInfo (input: ChartInput): TotalSummaryInfo!
	GetHardwareCustomerPieChart (input: ChartInput): PieChartData!
	GetSoftwareCustomerPieChart (input: ChartInput): PieChartData!
	GetHardwareConfigurationPieChart (input: ChartInput): PieChartData!
	GetSoftwareCreationBarChart (input: ChartInput): BarChartData!
	GetHardwareCreationBarChart (input: ChartInput): BarChartData!
	GetOrderCreationLineChart (input: ChartInput): LineChartData!
}


